-- Giới hạn 1-1000
local function getValue(box, current)
	local value = tonumber(box.Text)
	if not value then
		box.Text = tostring(current)
		return current
	end

	value = math.clamp(value, 1, 1000)
	box.Text = tostring(value)
	return value
end

speedBox.FocusLost:Connect(function()
	speed = getValue(speedBox, speed)

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = speed
	end
end)

jumpBox.FocusLost:Connect(function()
	jump = getValue(jumpBox, jump)

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.UseJumpPower = true
		hum.JumpPower = jump
	end
end)

flyBox.FocusLost:Connect(function()
	flySpeed = getValue(flyBox, flySpeed)
end)

-- Fly
local function stopFly()
	flying = false
	flyButton.Text = "FLY: OFF"

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if bv then bv:Destroy(); bv = nil end
	if bg then bg:Destroy(); bg = nil end
end

local function startFly()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	flying = true
	flyButton.Text = "FLY: ON"

	bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.Velocity = Vector3.zero
	bv.Parent = root

	bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	bg.P = 10000
	bg.Parent = root

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flying or not root.Parent then
			stopFly()
			return
		end

		local camera = workspace.CurrentCamera
		local move = Vector3.zero

		if UIS:IsKeyDown(Enum.KeyCode.W) then
			move += camera.CFrame.LookVector
		end
		if UIS:IsKeyDown(Enum.KeyCode.S) then
			move -= camera.CFrame.LookVector
		end
		if UIS:IsKeyDown(Enum.KeyCode.A) then
			move -= camera.CFrame.RightVector
		end
		if UIS:IsKeyDown(Enum.KeyCode.D) then
			move += camera.CFrame.RightVector
		end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then
			move += Vector3.yAxis
		end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
			move -= Vector3.yAxis
		end

		bv.Velocity = move.Magnitude > 0
			and move.Unit * flySpeed
			or Vector3.zero

		bg.CFrame = camera.CFrame
	end)
end

flyButton.MouseButton1Click:Connect(function()
	if flying then
		stopFly()
	else
		startFly()
	end
end)

-- Đóng / mở
openButton.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)
