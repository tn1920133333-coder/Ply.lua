title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = frame

-- Nút đóng
local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.fromOffset(35, 35)
closeButton.Position = UDim2.new(1, -42, 0, 5)
